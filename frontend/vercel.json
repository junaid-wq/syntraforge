{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/frame",
      "has": [{ "type": "host", "value": "syntraforge.me" }],
      "destination": "https://frame.syntraforge.me/",
      "permanent": true
    },
    {
      "source": "/frame/:path*",
      "has": [{ "type": "host", "value": "syntraforge.me" }],
      "destination": "https://frame.syntraforge.me/:path*",
      "permanent": true
    },
    {
