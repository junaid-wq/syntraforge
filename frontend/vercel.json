{
  "routes": [
    {
      "src": "^/sitemap\\.xml$",
      "has": [{ "type": "host", "value": "frame.syntraforge.me" }],
      "dest": "/sitemaps/frame.xml"
    },
    {
      "src": "^/sitemap\\.xml$",
      "has": [{ "type": "host", "value": "image.syntraforge.me" }],
      "dest": "/sitemaps/image.xml"
    },
    {
      "src": "^/sitemap\\.xml$",
      "has": [{ "type": "host", "value": "qr.syntraforge.me" }],
      "dest": "/sitemaps/qr.xml"
    },
    {
      "src": "^/sitemap\\.xml$",
      "has": [{ "type": "host", "value": "audio.syntraforge.me" }],
      "dest": "/sitemaps/audio.xml"
    },
    {
      "src": "^/$",
      "has": [{ "type": "host", "value": "image.syntraforge.me" }],
      "dest": "/compress/index.html"
    },
    {
      "src": "^/$",
      "has": [{ "type": "host", "value": "qr.syntraforge.me" }],
      "dest": "/qr/index.html"
    },
    {
      "src": "^/$",
      "has": [{ "type": "host", "value": "audio.syntraforge.me" }],
      "dest": "/audio/index.html"
    },
    {
      "handle": "filesystem"
    }
  ]
}